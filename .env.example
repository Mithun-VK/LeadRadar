# ============================================================
# LeadRadar — environment configuration
#
# Copy to .env and fill in. NEVER commit .env.
#
# Every variable below is SERVER-ONLY. No secret may ever be
# exposed through a NEXT_PUBLIC_* variable — src/lib/env.ts
# actively rejects that at boot.
#
# The application is fully functional with MOCK_EXTERNAL_APIS=true
# and NO provider credentials at all.
# ============================================================

NODE_ENV=development

# ------------------------------------------------------------
# Datastores (docker compose up -d provides both)
# ------------------------------------------------------------
# Host ports for the docker compose services. Defaults avoid 5432/6379,
# which are commonly already taken by a local PostgreSQL or Redis.
POSTGRES_PORT=5433
REDIS_PORT=6380

DATABASE_URL=postgresql://leadradar:leadradar@localhost:5433/leadradar?schema=public
REDIS_URL=redis://localhost:6380

# ------------------------------------------------------------
# Google Places API (New)
#
# LeadRadar requires rating, userRatingCount, websiteUri and phone,
# which are Enterprise-tier fields. Text Search Enterprise is billed
# $35 / 1,000 requests with 1,000 free requests per month, and each
# request returns up to 20 places — roughly 13,000 businesses/month
# at zero marginal cost.
#
# Leave blank when MOCK_EXTERNAL_APIS=true.
# ------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------
# Groq — the ONLY runtime AI provider.
# Claude/Anthropic APIs are deliberately not integrated.
# OpenAI-compatible endpoint: https://api.groq.com/openai/v1
#
# GROQ_MODEL is never hard-coded in application code.
# openai/gpt-oss-20b is the default: $0.075/1M in, $0.30/1M out,
# which makes a classification call ~$0.000285 — cheaper than a
# single Firecrawl page scrape.
# ------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------
# Firecrawl — web search + page scraping.
# 1 credit per scraped page; 2 credits per 10 search results.
# ------------------------------------------------------------
FIRECRAWL_API_KEY=

# ------------------------------------------------------------
# Mock mode. When true, all three providers are replaced by
# deterministic in-process fakes and no network calls are made.
# Must be false in production (enforced at boot).
# ------------------------------------------------------------
MOCK_EXTERNAL_APIS=true

# ------------------------------------------------------------
# Cost + concurrency guardrails.
# These are hard ceilings enforced in Redis BEFORE each provider
# call, not accounting done afterwards.
# ------------------------------------------------------------
MAX_RESULTS_PER_SEARCH=2000
MAX_GOOGLE_REQUESTS_PER_JOB=200
MAX_FIRECRAWL_REQUESTS_PER_JOB=1500
MAX_GROQ_REQUESTS_PER_JOB=500
MAX_CONCURRENT_JOBS=5

# ------------------------------------------------------------
# Budgets in USD. Reaching a limit pauses processing and emits a
# BUDGET_EXHAUSTED system event; it does not fail in-flight jobs.
# ------------------------------------------------------------
DAILY_BUDGET_USD=5
MONTHLY_BUDGET_USD=50

# ------------------------------------------------------------
# 32-byte key, hex-encoded (64 hex chars), for encrypting
# tenant-supplied secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------
ENCRYPTION_KEY=

# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------
LOG_LEVEL=info
