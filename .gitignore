# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- LeadRadar ---
# Secrets: never commit any .env variant. .env.example is the only tracked one.
.env
.env.*
!.env.example

# Prisma generated client
/src/generated
/prisma/*.db
/prisma/*.db-journal

# Test + build artefacts
/coverage
/playwright-report
/test-results
*.tsbuildinfo

# Local exports produced by the export worker
/tmp
/exports

# Editor
.idea
.vscode/*
!.vscode/extensions.json

# Runtime logs and local verification artefacts
worker.log
*.log
