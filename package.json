{
  "name": "leadradar",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered local-business prospecting and digital-opportunity intelligence platform for agencies.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/workers/index.ts",
    "worker:dev": "tsx watch src/workers/index.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "guard:providers": "tsx scripts/guard-providers.ts",
    "check": "npm run guard:providers && npm run typecheck && npm run lint && npm run test",
    "verify:pipeline": "tsx scripts/verify-pipeline.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.17.1",
    "@tanstack/react-table": "^8.21.3",
    "bullmq": "^5.66.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "groq-sdk": "^0.37.0",
    "ioredis": "^5.9.0",
    "lucide-react": "^0.548.0",
    "nanoid": "^5.1.7",
    "next": "16.3.0",
    "pino": "^10.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.66.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
